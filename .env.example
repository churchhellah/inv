# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится (см. .gitignore).

# Токен T-Invest API для песочницы (sandbox). Получить в приложении/личном кабинете Т-Инвестиций.
TINVEST_TOKEN_SANDBOX=

# Токен T-Invest API для боевого счёта. Использовать только когда mode: production в config.yaml
# осознанно включён человеком.
TINVEST_TOKEN_PROD=

# ID sandbox-счёта — создаётся через scripts/sandbox_bootstrap.py, оно же выведет значение.
TINVEST_ACCOUNT_ID_SANDBOX=

# ID реального брокерского счёта — узнать через scripts/list_accounts.py.
TINVEST_ACCOUNT_ID_PROD=
